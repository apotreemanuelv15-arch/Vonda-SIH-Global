{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/radar-ia/",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/voice/webhook/",
      "schedule": "0 0 * * *"
    }
  ]
}
